# aspect-archive configuration.
#
#   cp .env.template .env      # .env is git-ignored; edit it, don't edit this
#
# Read at startup by aspect/config.py (Settings) -- by the server, by every
# script under scripts/, and by the test suite. Precedence is: real environment
# variable > .env > the default shown here. Every key is optional; commented-out
# lines below are the defaults.
#
# List values are parsed as JSON, e.g. ASPECT_USER_NAMES=["USER","Matt"].


# --- Where cards live -------------------------------------------------------

# flat   -- <name>_<id8>.png, one directory. Required by SillyTavern: it does
#           not recurse into subfolders.
# nested -- <creator>/<name>_<id8>.png, the original layout. The creator is on
#           the card either way (extensions.jai.creatorName), and the id
#           fragment keeps filenames unique, so flat loses nothing.
#ASPECT_CARD_LAYOUT=flat


# --- The archive ------------------------------------------------------------
# What the browse API reads, and what a build writes into -- one directory, no
# sync step, no second copy to reconcile. Defaults live under the repo's
# gitignored `data/`, so a developer and the container see the same layout at
# the same relative path: in the container `data/` IS the volume mount, and
# nothing needs to be reconfigured. To relocate the archive, mount something
# else at `data/characters` (or override this directly) -- there is no
# separate "build elsewhere" knob.
#ASPECT_ARCHIVE_DIR=./data/characters
#ASPECT_GALLERIES_DIR=./data/galleries

# Thumbnail caches: avatar/ keyed by the exact card filename, gallery/ keyed by
# <Name>_<gallery_id>. Both were inherited at cutover (from SillyTavern's
# thumbnails/ and CharacterLibrary's cl_thumbs/). Pure cache: safe to delete,
# regenerated on miss.
#ASPECT_THUMBS_DIR=./data/cache/thumbs

# Server working state -- hidden-definition captures and the lorebook cache.
# Beside the archive rather than inside it, but still under `data/`: that is the
# one directory a container mounts, and nothing the server writes may land
# outside it (in a container, that would mean writing into the image).
#ASPECT_CAPTURES_DIR=./data/state/captures
#ASPECT_LOREBOOK_CACHE_DIR=./data/state/lorecache


# --- Server -----------------------------------------------------------------

# Loopback only, so nothing on the network can reach the archive. The container
# overrides this to 0.0.0.0 (the compose port publish is the boundary instead) --
# it is the only variable the container sets.
#ASPECT_HOST=127.0.0.1
# Effectively fixed: both userscripts hardcode http://127.0.0.1:8000.
#ASPECT_PORT=8000
#ASPECT_REQUEST_TIMEOUT=120.0
#ASPECT_ALLOWED_ORIGINS=["*"]


# --- Card building ----------------------------------------------------------

# Persona names reversed back to {{user}} in captured prose. Add whatever names
# you actually chat under on JanitorAI / saucepan.
#ASPECT_USER_NAMES=["USER"]

# Lossily quantize avatars with pngquant before embedding. Fails soft when the
# binary is missing.
#ASPECT_COMPRESS=true
#ASPECT_PNGQUANT_BIN=./proxy/pngquant


# --- Chat replies (the definition-capture assist) ----------------------------

# There is no model: `/v1/chat/completions` exists so JanitorAI hands over the
# hidden definition in its system prompt, and the reply is assembled locally
# from canned fragments (aspect/mock_responder.py). This is only the model id
# advertised at /v1/models, for the site's provider settings.
#ASPECT_MOCK_MODEL=jai-proxy-mock


# --- Media downloads ---------------------------------------------------------

# How many media items one download run fetches at once, and how many of those
# may target a single host. The per-host cap is the one that usually binds --
# a card's gallery is typically all on one image host -- and it is what keeps a
# large gallery from looking like a hammering to that host. Set either to 1 for
# the old strictly serial behaviour.
#ASPECT_MEDIA_CONCURRENCY=6
#ASPECT_MEDIA_PER_HOST_CONCURRENCY=3

# --- Outbound proxy ----------------------------------------------------------

# Routes everything this server fetches from the internet through an HTTP(S)
# proxy: media downloads, card avatars, the datacat.run lookups, and the
# /proxy passthrough the browse UI falls back to. Leave unset to call directly.
#
# This is the *fallback*. Settings -> General -> Outbound Proxy in the browser
# writes `httpProxyUrl` into data/settings.json, and that wins when set -- it is
# the one a person can change without restarting the container. Use this to
# configure a deployment before anyone opens the browser.
#
# SOCKS URLs (socks5://, socks5h://) need the httpx[socks] extra installed; one
# given without it is logged and ignored rather than failing a download.
#ASPECT_HTTP_PROXY=http://127.0.0.1:8080

# datacat.run anonymous session token. Left unset the first time -- the
# resolver fetches one and writes this key back into your .env itself, so
# later runs reuse it instead of re-hitting the identify endpoint. No need to
# set this by hand.
#ASPECT_DATACAT_SESSION_TOKEN=

# --- Terminal output ---------------------------------------------------------

# The live dashboard (log column + downloads column). On by default whenever
# the server runs in a terminal; set false to always use plain logging.
#ASPECT_DASHBOARD=false
